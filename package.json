{
  "name": "brain-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preinstall": "echo '⚙ brAIn — installing deps. After this, run: pnpm start' >&2",
    "postinstall": "pnpm --filter @brain/sdk build && pnpm --filter @brain/core build && pnpm --filter @brain/agent build && node scripts/clone-store.mjs && node scripts/install-nats.mjs && node scripts/ensure-store-built.mjs",
    "start": "node scripts/ensure-store-built.mjs && concurrently -n api,dashboard -c blue,magenta \"pnpm --filter @brain/api dev\" \"wait-on http-get://localhost:3000/network -t 120000 && pnpm --filter @brain/dashboard dev\"",
    "start:prod": "node packages/api/dist/main.js",
    "dev:api": "pnpm --filter @brain/api dev",
    "dev:dashboard": "pnpm --filter @brain/dashboard dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist",
    "kill-orphans": "node scripts/kill-orphans.mjs",
    "kill-ports": "node scripts/kill-ports.mjs",
    "brain": "node scripts/brain.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@lancedb/lancedb",
      "@lancedb/lancedb-darwin-arm64",
      "@lancedb/lancedb-darwin-x64",
      "@lancedb/lancedb-linux-x64-gnu",
      "@lancedb/lancedb-linux-arm64-gnu"
    ],
    "overrides": {
      "vitest": "^3.2.4"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
